#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
demo="$repo_root/apps/demo"

# The demo uses SQLite and needs no long-running backing service. Repair the
# writable runtime paths that may be absent after restoring an orb snapshot.
mkdir -p "$demo/database" "$demo/bootstrap/cache" \
    "$demo/storage/framework/cache" "$demo/storage/framework/sessions" \
    "$demo/storage/framework/testing" "$demo/storage/framework/views" "$demo/storage/logs"
touch "$demo/database/database.sqlite"

echo "Orb resumed: PHP/Composer, Bun, and demo SQLite state are ready"
