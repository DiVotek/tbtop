    {
        return [
            $s->action('edit')->label('Edit')->url(EditPage::url(['{{ var }}' => request()->route('{{ var }}')])),
        ];
    }

    public function view(S $s): Node
    {
        $record = {{ model }}::query(){{ with }}->whereKey(request()->route('{{ var }}'))->firstOrFail();

        return $s->stack([
            $s->displayKeyValue([
{{ display }}
            ]),
        ]);
    }
}
