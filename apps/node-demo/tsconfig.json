{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["vite/client", "bun"],
		"paths": {
			"@tbtop/inertia-admin": ["../../packages/client/src/index.ts"],
			"@tbtop/admin": ["../../packages/node/src/index.ts"],
			"@tbtop/admin/example/posts": ["../../packages/node/example/posts.ts"]
		}
	},
	"include": ["src", "server.ts", "vite.config.ts"]
}
